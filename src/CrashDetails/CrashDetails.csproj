<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>GorillaCrashDetails</AssemblyName>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.2.0.0</FileVersion>
    <Deterministic>true</Deterministic>
    <GorillaAssembly Condition="'$(GorillaAssembly)' == ''">$(MSBuildThisFileDirectory)../../build/original/Gorilla Mod Manager 26.exe</GorillaAssembly>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="GorillaModManager">
      <HintPath>$(GorillaAssembly)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
